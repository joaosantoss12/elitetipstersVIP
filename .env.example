# ── Supabase (novo projeto dedicado a este site) ────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key — nunca expor no frontend

# ── Telegram (bot NOVO, dedicado a este site) ───────────────────────────
# Cria o bot com o @BotFather (/newbot). Depois:
#   /setdomain -> domínio deste site (para o widget de login funcionar)
# TELEGRAM_CLIENT_ID / VITE_TELEGRAM_CLIENT_ID = o ID numérico do bot (não o
# username) — é a mesma coisa dos dois lados, um para o servidor, outro para
# o Vite injetar no browser.
TELEGRAM_CLIENT_ID=123456789
VITE_TELEGRAM_CLIENT_ID=123456789

# Token do bot (@BotFather -> /mybots -> o teu bot -> API Token). Usado
# para gerar os links de convite de uso único para o grupo VIP.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do grupo/canal privado do Telegram para onde o bot vai gerar convites.
# O bot TEM de ser administrador desse grupo com permissão de convidar
# utilizadores. IDs de grupo são negativos (ex: -1001234567890).
NEW_GROUP_ID=-1001234567890

# Segredo aleatório só teu, usado para assinar o cookie de sessão do login
# Telegram. Gera um com: openssl rand -hex 32
SESSION_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
